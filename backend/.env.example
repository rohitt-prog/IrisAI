# ════════════════════════════════════════════════════════════════════════════
# IRISAI Backend Configuration
# ════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git (it's already in .gitignore)

# ── MongoDB Connection String ───────────────────────────────────────────────
# Local development:
#   MONGO_URI=mongodb://localhost:27017/iris_health
#
# MongoDB Atlas (FREE cloud database):
#   1. Sign up at: https://www.mongodb.com/atlas
#   2. Create a free cluster (M0 tier)
#   3. Add your IP to Network Access
#   4. Create database user
#   5. Get connection string from "Connect" button
#   Example: mongodb+srv://username:password@cluster.mongodb.net/iris_health
#
MONGO_URI=mongodb://localhost:27017/iris_health

# ── JWT Secret Key ──────────────────────────────────────────────────────────
# CRITICAL: Generate a secure random key for production!
#
# Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# Example output: 8f7a9b2c... (64 characters)
#
# NEVER use the default value in production!
# NEVER commit your real secret key to git!
#
JWT_SECRET_KEY=change-this-to-a-long-random-string

# ── Google Gemini API Key ───────────────────────────────────────────────────
# Required for AI-powered explanations and chat assistant
#
# Get your FREE API key from:
#   https://aistudio.google.com/app/apikey
#
# Note: Free tier includes 60 requests per minute
#
GEMINI_API_KEY=your_gemini_api_key_here

# ════════════════════════════════════════════════════════════════════════════
# Optional Configuration (uses defaults if not set)
# ════════════════════════════════════════════════════════════════════════════

# Flask environment (development or production)
# FLASK_ENV=development

# Server host and port
# HOST=0.0.0.0
# PORT=5001
