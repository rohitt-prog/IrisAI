# .env.example — copy this to .env and fill in your real values
# NEVER commit .env to git (it is already in .gitignore)

# ── Google Gemini API Key ──────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── MongoDB Connection String ─────────────────────────────────────────────
# Local:  mongodb://localhost:27017/iris_health
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/iris_health
MONGO_URI=mongodb://localhost:27017/iris_health

# ── JWT Secret Key ────────────────────────────────────────────────────────
# Use a long random string in production. Example: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-long-random-string
